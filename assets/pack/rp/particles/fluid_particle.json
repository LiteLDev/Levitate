{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "levitate:fluid_particle",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/levitate_fluid"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "direction": ["variable.dir_x", "variable.dir_y", "variable.dir_z"]
      },
      "minecraft:particle_initial_speed": "variable.speed",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.2 / math.random(0.1, 1.0)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -16, 0],
        "linear_drag_coefficient": 0.4
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.05,
        "coefficient_of_restitution": 0,
        "collision_drag": 10
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.05 + variable.particle_random_3 * 0.05", "0.05 + variable.particle_random_3 * 0.05"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": ["math.floor(variable.particle_random_1 * 3.99) * 4", "math.floor(variable.particle_random_2 * 3.99) * 4"],
          "uv_size": [4, 4]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": ["variable.r", "variable.g", "variable.b", 1]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
