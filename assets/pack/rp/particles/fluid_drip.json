{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "levitate:fluid_drip",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/levitate_fluid"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "direction": ["variable.dir_x", "variable.dir_y", "variable.dir_z"]
      },
      "minecraft:particle_initial_speed": "variable.speed",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "3.2 / math.random(0.2, 1.0)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, "variable.particle_age < variable.particle_lifetime - 0.75 ? -0.96 : -16", 0],
        "linear_drag_coefficient": "variable.particle_age < variable.particle_lifetime - 0.75 ? 4 : 0.4"
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.03,
        "coefficient_of_restitution": 0,
        "collision_drag": 10,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "size": [0.03, 0.04],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [5, 5],
          "uv_size": [2, 2]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": ["variable.r", "variable.g", "variable.b", 1]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
