{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "levitate:steam_jet",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "variable.dir_x + math.random(-0.1, 0.1)",
          "variable.dir_y + math.random(-0.1, 0.1)",
          "variable.dir_z + math.random(-0.1, 0.1)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.6 + math.random(0, 0.4)"
      },
      "minecraft:particle_initial_speed": "variable.speed",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 0.3, 0],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12 + variable.particle_age * 0.3",
          "0.12 + variable.particle_age * 0.3"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [56, 0],
            "size_UV": [8, 8],
            "step_UV": [-8, 0],
            "frames_per_second": 4,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [0.93, 0.93, 0.96, "0.35 * (1 - variable.particle_age / variable.particle_lifetime)"]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
