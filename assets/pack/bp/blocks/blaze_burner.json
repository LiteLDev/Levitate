{
  "format_version": "1.21.70",
  "minecraft:block": {
    "description": {
      "identifier": "levitate:blaze_burner",
      "menu_category": { "category": "items" },
      "states": {
        "levitate:blaze": [1, 2, 3, 4],
        "levitate:facing": [3, 2, 4, 5],
        "levitate:rotor": [0, 1]
      }
    },
    "components": {
      "minecraft:geometry": {
        "identifier": "geometry.levitate.blaze_burner",
        "bone_visibility": {
          "base": true,
          "cage": true,
          "head": "q.block_state('levitate:rotor') == 0",
          "flame": "q.block_state('levitate:blaze') >= 2"
        }
      },
      "minecraft:material_instances": {
        "*": { "texture": "levitate_blaze_burner_base", "render_method": "alpha_test" },
        "side": { "texture": "levitate_blaze_burner_base", "render_method": "alpha_test" },
        "top": { "texture": "levitate_blaze_burner_top", "render_method": "alpha_test" },
        "bottom": { "texture": "levitate_blaze_burner_base", "render_method": "alpha_test" },
        "cage": { "texture": "levitate_blaze_burner_cage", "render_method": "alpha_test" },
        "face": { "texture": "levitate_blaze_burner_head_smouldering_front", "render_method": "alpha_test" },
        "head": { "texture": "levitate_blaze_burner_head_smouldering", "render_method": "alpha_test" },
        "flame": { "texture": "levitate_blaze_burner_flame", "render_method": "alpha_test" }
      },
      "minecraft:collision_box": { "origin": [-8, 0, -8], "size": [16, 14, 16] },
      "minecraft:selection_box": { "origin": [-8, 0, -8], "size": [16, 14, 16] },
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 2.5 },
      "minecraft:destructible_by_explosion": { "explosion_resistance": 6 },
      "minecraft:light_dampening": 0,
      "minecraft:light_emission": 8,
      "minecraft:map_color": "#5f6368",
      "minecraft:loot": "loot_tables/blocks/blaze_burner.json"
    },
    "permutations": [
      { "condition": "q.block_state('levitate:facing') == 3", "components": { "minecraft:transformation": { "rotation": [0, 180, 0] } } },
      { "condition": "q.block_state('levitate:facing') == 4", "components": { "minecraft:transformation": { "rotation": [0, 90, 0] } } },
      { "condition": "q.block_state('levitate:facing') == 5", "components": { "minecraft:transformation": { "rotation": [0, 270, 0] } } },
      {
        "condition": "q.block_state('levitate:blaze') >= 2 && q.block_state('levitate:blaze') <= 3",
        "components": {
          "minecraft:light_emission": 15,
          "minecraft:material_instances": {
            "*": { "texture": "levitate_blaze_burner_base", "render_method": "alpha_test" },
            "side": { "texture": "levitate_blaze_burner_base", "render_method": "alpha_test" },
            "top": { "texture": "levitate_blaze_burner_top", "render_method": "alpha_test" },
            "bottom": { "texture": "levitate_blaze_burner_base", "render_method": "alpha_test" },
            "cage": { "texture": "levitate_blaze_burner_cage", "render_method": "alpha_test" },
            "face": { "texture": "levitate_blaze_burner_head_kindled_front", "render_method": "alpha_test" },
            "head": { "texture": "levitate_blaze_burner_head_kindled", "render_method": "alpha_test" },
            "flame": { "texture": "levitate_blaze_burner_flame", "render_method": "alpha_test" }
          }
        }
      },
      {
        "condition": "q.block_state('levitate:blaze') == 4",
        "components": {
          "minecraft:light_emission": 15,
          "minecraft:material_instances": {
            "*": { "texture": "levitate_blaze_burner_base", "render_method": "alpha_test" },
            "side": { "texture": "levitate_blaze_burner_base", "render_method": "alpha_test" },
            "top": { "texture": "levitate_blaze_burner_top", "render_method": "alpha_test" },
            "bottom": { "texture": "levitate_blaze_burner_base", "render_method": "alpha_test" },
            "cage": { "texture": "levitate_blaze_burner_cage", "render_method": "alpha_test" },
            "face": { "texture": "levitate_blaze_burner_head_seething_front", "render_method": "alpha_test" },
            "head": { "texture": "levitate_blaze_burner_head_seething", "render_method": "alpha_test" },
            "flame": { "texture": "levitate_blaze_burner_flame_seething", "render_method": "alpha_test" }
          }
        }
      }
    ]
  }
}
